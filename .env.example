# Claude API
ANTHROPIC_API_KEY=

# Google API — 로컬/PaaS 중 하나 선택:
# [로컬 개발] sa-key.json 파일 경로
GOOGLE_SA_KEY_PATH=sa-key.json

# [Railway/PaaS] sa-key.json 파일 내용을 JSON 문자열로 (GOOGLE_SA_KEY_PATH 대신 사용)
# GOOGLE_SA_KEY_JSON={"type":"service_account","project_id":"..."}

# Google Workspace 위임 대상
GOOGLE_DELEGATED_USER=wirye@wiryeschoolcomunity.com

# PostgreSQL (Railway 자동 주입)
# DATABASE_URL=postgresql://user:pass@host:port/dbname

# DB SoT 전환 (true=PostgreSQL, false=Sheets 유지)
# USE_DB_SOT=false

# n8n 웹훅 URL (DB→Sheets 동기화)
# N8N_WEBHOOK_URL=https://your-n8n-instance.up.railway.app

# LangSmith (관측성 — 설정하면 모든 LangChain 호출 자동 추적)
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=WiryeSchoolCommunity

# Google Drive/Sheets 환경별 ID (미설정 시 production 기본값 사용)
# dev Railway에서만 설정. prod는 설정 불필요.
# MEMBERS_SHEET_ID=
# OPERATIONS_FOLDER_ID=
# MEMBERS_FOLDER_ID=
