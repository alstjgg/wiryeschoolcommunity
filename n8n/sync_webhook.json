        "query": "SELECT applied_at, term_id, name_id, name, type, course_name,\n       expected_amount, payment_status, payment_time, payer_name,\n       review_reason, processing_status\nFROM applications\nWHERE term_id = '{{ $json.body.term_id }}'\nORDER BY id",
