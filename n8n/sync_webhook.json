      "parameters": {
        "jsCode": "const statusMap = {\n  confirmed: '✅정상',\n  needs_review: '🔶확인필요',\n  not_paid: '❌미입금',\n  name_mismatch: '⚠️이름불일치',\n  duplicate: '🔄중복',\n  exempted: '💎면제',\n};\nconst COLS = ['applied_at','term_id','name_id','name','type','course_name',\n  'expected_amount','payment_status','payment_time','payer_name',\n  'review_reason','processing_status'];\nconst rows = $input.all().map(item => {\n  return COLS.map(col => {\n    let val = item.json[col] ?? '';\n    if (col === 'payment_status') val = statusMap[val] || val;\n    return String(val);\n  });\n});\nreturn [{ json: { values: rows } }];"
